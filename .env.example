# Optional: real AI replies in chat. Without it, the app uses mock replies.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Free alternative for testing: Groq (used when ANTHROPIC_API_KEY is empty).
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Real integrations (optional).
# Easiest: Composio handles the Google and Shopify sign-in. Get a key at dashboard.composio.dev → Settings → API Keys.
# When set, Gmail and Google Drive connect through Composio and the Google keys below are not needed.
COMPOSIO_API_KEY=
# Composio has no shared Shopify app. To run Shopify through Composio, create a Shopify auth config
# (with your own Shopify app) in the Composio dashboard and put its id here. Otherwise Shopify uses the keys below.
# COMPOSIO_SHOPIFY_AUTH_CONFIG_ID=ac_...

# Alternative: your own OAuth apps. Tokens are stored encrypted in a cookie per browser.
# Gmail + Google Drive: one Google Cloud OAuth client (Web application). Add both redirect URIs:
#   <your site>/api/integrations/gmail/callback
#   <your site>/api/integrations/drive/callback
# Enable "Gmail API" and "Google Drive API" in the Google Cloud project. See README → Integrations.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Shopify: app from the Shopify Dev Dashboard. Redirect URL: <your site>/api/integrations/shopify/callback
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# SHOPIFY_API_VERSION=2026-07
# Fixed site URL used for OAuth redirects (set it in Vercel so preview URLs don't break sign-in)
# APP_URL=https://your-site.vercel.app
# Optional: a separate secret for cookie encryption
# INTEGRATIONS_SECRET=
