# Optional: real AI replies in chat. Without it, the app uses mock replies.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Free alternative for testing: Groq (used when ANTHROPIC_API_KEY is empty).
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Real integrations (optional). Tokens are stored encrypted in a cookie per browser.
# Gmail: Google Cloud OAuth client (Web). Redirect URI: <your site>/api/integrations/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Shopify: app from the Shopify Dev Dashboard. Redirect URL: <your site>/api/integrations/shopify/callback
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# SHOPIFY_API_VERSION=2026-07
# Optional: fixed site URL for OAuth redirects, and a separate secret for cookie encryption
# APP_URL=https://your-site.vercel.app
# INTEGRATIONS_SECRET=
